{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["**/*.ts"],
	// test-soak runs under the extension's vitest and imports `vitest`, which the root does not declare.
	"exclude": ["ci-cd/test-soak/**"]
}
