{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"moduleDetection": "force",
		"lib": ["ESNext", "DOM"],
		"types": ["bun", "node", "vite/client", "chrome-types"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["scripts/**/*.ts", "vite.*.config.mts", "src/types/console.d.ts"]
}
