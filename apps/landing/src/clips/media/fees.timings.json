{
	"duration": 40.64,
	"scenes": [
		{ "id": "s1", "start": 0, "end": 5.52, "text": "Every Aztec transaction pays a network fee, the way Ethereum charges gas." },
		{
			"id": "s2",
			"start": 5.52,
			"end": 15.12,
			"text": "The fee is paid in Fee Juice, the token that pays network fees on Aztec. You bring it over from Ethereum, and it is used only for fees."
		},
		{
			"id": "s3",
			"start": 15.12,
			"end": 24.16,
			"text": "The price depends on the work: publishing the transaction's data, and running it on the network. Nulo shows you the fee before you send."
		},
		{
			"id": "s4",
			"start": 24.16,
			"end": 36.64,
			"text": "How you pay matters. Pay with public Fee Juice, and the record names you as the payer, each time. Pay with private Fee Juice, and the payer on record is a contract many people share."
		},
		{ "id": "s5", "start": 36.64, "end": 40.64, "text": "Sometimes the fee is sponsored: someone else pays it for you." }
	],
