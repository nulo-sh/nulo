{
	"duration": 45.192,
	"scenes": [
		{ "id": "s1", "start": 0, "end": 4.826, "text": "Every Aztec transaction pays a network fee, the way Ethereum charges gas." },
		{
			"id": "s2",
			"start": 4.826,
			"end": 18.13,
			"text": "The fee is paid in Fee Juice, the token that pays network fees on Aztec. You bring the Aztec token over from Ethereum, and it becomes Fee Juice. Once converted, it cannot be transferred, and it is used only for fees."
		},
		{
			"id": "s3",
			"start": 18.13,
			"end": 25.991,
			"text": "The price depends on the work: publishing the transaction's data, and running it on the network. Nulo shows you the fee before you send."
		},
		{
			"id": "s4",
			"start": 25.991,
			"end": 36.843,
			"text": "How you pay matters. Pay with public Fee Juice, and the record names you as the payer, each time. Pay with private Fee Juice, and the payer on record is a contract many people share."
		},
		{ "id": "s5", "start": 36.843, "end": 40.487, "text": "Sometimes the fee is sponsored: someone else pays it for you." },
		{ "id": "s6", "start": 40.487, "end": 45.192, "text": "Nulo always tells you how the fee is paid, and you are always in control." }
	],
