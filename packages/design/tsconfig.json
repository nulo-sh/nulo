{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"incremental": true,
		"jsx": "preserve",
		"lib": ["ESNext", "DOM"],
		"useDefineForClassFields": true,
		"resolveJsonModule": true,
		"esModuleInterop": true
	},
	"include": ["package.json", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
	"exclude": ["src/**/*.stories.ts"]
}
