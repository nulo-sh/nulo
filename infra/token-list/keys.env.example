# Keyed-run template for the token-list key ceremony:
#   env-exec request --template infra/token-list/keys.env.example --slug token-list-keys -- \
#     bun packages/token-list/src/keygen-cli.ts install
# `op-remote create` generates both Ed25519 seeds in 1Password; no value ever exists in a file.
# The CI seed becomes the `token-list` environment secret; the recovery seed never leaves 1Password.

# op: generate hex32
TOKEN_LIST_CI_SEED=op://Keyed-Runs/Nulo-TokenList/TOKEN_LIST_CI_SEED
# op: generate hex32
TOKEN_LIST_RECOVERY_SEED=op://Keyed-Runs/Nulo-TokenList/TOKEN_LIST_RECOVERY_SEED
