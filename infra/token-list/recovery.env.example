# Keyed-run template for signing with the offline recovery key, after the CI key is rotated out:
#   env-exec request --template infra/token-list/recovery.env.example --slug token-list-recovery -- \
#     bun packages/token-list/src/sign-cli.ts --key-id nulo-recovery-1 --seed-env TOKEN_LIST_RECOVERY_SEED \
#     --source infra/token-list/list.source.json --published infra/token-list/public/v1/list.json \
#     --out infra/token-list/public/v1/list.json
# The run writes the envelope into the worktree; commit it in a PR. The CI seed is not streamed.

TOKEN_LIST_RECOVERY_SEED=op://Keyed-Runs/Nulo-TokenList/TOKEN_LIST_RECOVERY_SEED
