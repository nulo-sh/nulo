{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nulo-subscribe",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	"account_id": "0f1688fc6a4b6acf3fa55cf71e1bed26",
	// This Worker holds a full-access Resend key: nulo-landing's service binding is its only way
	// in. No workers.dev origin, no preview URL, no route.
	"workers_dev": false,
	"preview_urls": false,
	// Workers Logs would keep request metadata (the visitor's IP among it) on a dashboard.
	"observability": { "enabled": false },
	"vars": {
		"RESEND_SEGMENT_ID": "6f48382e-5d4c-4b81-8631-231b0b18e206",
		"RESEND_TOPIC_ID": "bd2fd224-25d7-4707-9742-1e3ffc39f9d7",
		"CONSENT_VERSION": "1.0",
		"SUBSCRIBE_OFF": "0"
	},
	// Counted per Cloudflare location and approximate: a ceiling on bursts, not an exact quota.
	"ratelimits": [
		{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
	]
}
